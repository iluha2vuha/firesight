# Copy this to .env.local and adjust if your backend runs on a different port
VITE_BACKEND_URL=http://localhost:8000

# Optional: override the standard OpenStreetMap basemap with another light raster provider.
# Set both the tile URL and that provider's required attribution. Browser-visible keys only.
# VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
